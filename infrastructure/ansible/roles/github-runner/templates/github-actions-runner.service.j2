[Unit]
Description=GitHub Actions Runner ({{ github_runner_name }})
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User={{ runner_user }}
WorkingDirectory={{ runner_dir }}
ExecStart={{ runner_dir }}/run.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=process

[Install]
WantedBy=multi-user.target
