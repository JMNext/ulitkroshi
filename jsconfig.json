{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "preserve",
    "checkJs": true,
    "baseUrl": ".",
    "paths": {
      "*": ["frontend/src/*"]
    }
  },
  "include": ["frontend/src/**/*"],
  "exclude": ["**/node_modules", "**/dist"]
}
