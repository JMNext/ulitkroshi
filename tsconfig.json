{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./frontend/src/*"],
      "~/*": ["./backend/src/*"]
    }
  },
  "include": [
    "frontend/index.tsx",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "frontend/src/**/*.d.ts",
    "frontend/vite-env.d.ts",
    "backend/src/**/*.ts",
    "frontend/src/App.tsx",
    "frontend/game-scenes.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
