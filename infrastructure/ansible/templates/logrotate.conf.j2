/var/log/ulitkroshi/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0640 {{ user_name }} {{ user_name }}
    sharedscripts
    postrotate
        docker ps --filter "name=orion" --format "{{.Names}}" | xargs -r docker kill -HUP || true
    endscript
}

/var/log/nginx/{{ apex_domain }}-*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 `cat /var/run/nginx.pid`
    endscript
}