# Upstream definitions
{% for vhost in vhosts %}
upstream {{ vhost.name }} {
    server 127.0.0.1:{{ vhost.port }};
    keepalive 32;
}
{% endfor %}

# ────────────────────────────────────────────
# Redirect: apex → www
# ────────────────────────────────────────────
{% if apex_domain is defined %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ apex_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        {% if apex_domain in (ssl_domains | default([])) %}
        return 301 https://www.{{ apex_domain }}$request_uri;
        {% else %}
        return 301 http://www.{{ apex_domain }}$request_uri;
        {% endif %}
    }
}

{% if apex_domain in (ssl_domains | default([])) %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ apex_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ apex_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ apex_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    return 301 https://www.{{ apex_domain }}$request_uri;
}
{% endif %}
{% endif %}

# ────────────────────────────────────────────
# Vhosts - HTTP only (for all)
# ────────────────────────────────────────────
{% for vhost in vhosts %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ vhost.domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        {% if vhost.domain in (ssl_domains | default([])) %}
        return 301 https://{{ vhost.domain }}$request_uri;
        {% else %}
        proxy_pass http://{{ vhost.name }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        {% endif %}
    }
}

{% if vhost.domain in (ssl_domains | default([])) %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ vhost.domain }};

    ssl_certificate /etc/letsencrypt/live/{{ vhost.domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ vhost.domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    {% if vhost.health_check | default(false) %}
    location /health {
        access_log off;
        return 200 "healthy\n";
    }
    {% endif %}

    {% if vhost.has_api | default(false) %}
    location /api/ {
        proxy_pass http://{{ vhost.name }}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
    {% endif %}

    location / {
        proxy_pass http://{{ vhost.name }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
{% endif %}
{% endfor %}